FROM alpine:3.22

LABEL org.opencontainers.image.title="pz-backup-sidecar" \
      org.opencontainers.image.description="Periodic PZ world/player-data backup to S3"

RUN apk add --no-cache aws-cli bash tar gzip coreutils sqlite

COPY --chmod=0755 backup.sh  /usr/local/bin/backup.sh
COPY --chmod=0755 restore.sh /usr/local/bin/restore.sh

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/backup.sh"]
